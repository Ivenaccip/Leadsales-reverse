# ============================================================
#  LeadLibre — configuración (copia este archivo como .env)
# ============================================================

# URL pública con la que tu equipo y Meta llegan al servidor (HTTPS en producción).
# El webhook de WhatsApp será: ${PUBLIC_URL}/webhooks/whatsapp
PUBLIC_URL=https://crm.tudominio.com

# Solo si usas el perfil "https" de docker compose (Caddy): tu dominio, apuntando a este servidor.
DOMAIN=crm.tudominio.com

# Puerto local de la app (docker compose lo publica en este puerto).
APP_PORT=3000

# Contraseña de PostgreSQL (docker compose). Sin DATABASE_URL la app usa una base embebida en DATA_DIR.
POSTGRES_PASSWORD=cambia-esta-contraseña
# DATABASE_URL=postgres://usuario:contraseña@host:5432/leadlibre

# Carpeta de datos: archivos multimedia, base embebida y llaves generadas.
# DATA_DIR=./data

# Llaves secretas. Si las dejas vacías se generan y guardan en DATA_DIR/secrets.json.
# Si las defines, ¡no las cambies después! (ENCRYPTION_KEY cifra los tokens de Meta).
# JWT_SECRET=
# ENCRYPTION_KEY=

# ¿Cualquiera puede registrarse y crear su espacio? (true = comunidad abierta)
# El primer usuario registrado siempre es el administrador de la instancia.
ALLOW_SIGNUP=true

# Modelo de créditos por defecto para espacios nuevos:
#   meta_direct = cada negocio paga a Meta con su tarjeta (sin intermediarios). Recomendado.
#   prepaid     = el administrador recarga créditos y se descuentan por mensaje.
BILLING_MODE=meta_direct
# Créditos de regalo (USD) para espacios nuevos en modo prepaid.
SIGNUP_CREDITS=0

# Versión de la Graph API de Meta.
META_GRAPH_VERSION=v23.0

# Opcional: valores globales si toda la comunidad usa UNA app de Meta (Tech Provider).
# Cada canal también guarda su propio verify token y app secret.
# META_VERIFY_TOKEN=
# META_APP_SECRET=

# Opcional: llave de Claude para el agente IA si un negocio no captura la suya.
# ANTHROPIC_API_KEY=

# Velocidad de difusiones (mensajes por segundo por instancia). Meta permite ~80 mps por número.
BROADCAST_RATE_PER_SECOND=10

# Tamaño máximo de archivos adjuntos (MB).
MAX_UPLOAD_MB=16

# Permitir webhooks salientes a IPs privadas/LAN (desactivado por seguridad).
ALLOW_PRIVATE_WEBHOOKS=false

LOG_LEVEL=info
